# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env
# ===== Database (MySQL / MariaDB) =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=job_portal_db
DB_USERNAME=root
DB_PASSWORD=

# ===== Server =====
SERVER_PORT=8080

# ===== App & JPA =====
APP_SEED_ENABLED=true
HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_DEV_MODE=false

# ===== SePay VietQR Payment Configuration =====
SEPAY_API_KEY=your_sepay_api_key
SEPAY_BANK_CODE=BIDV
SEPAY_ACCOUNT_NUMBER=your_bank_account_number
SEPAY_ACCOUNT_HOLDER=CONG TY TNHH JOBVIET
