# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env
DB_HOST=localhost
DB_PORT=3306
DB_NAME=job_portal_db
DB_USERNAME=root
DB_PASSWORD=
# Đổi nếu cổng 8080 bị chiếm (nhớ đổi VITE_API_TARGET ở frontend tương ứng)
SERVER_PORT=8080
# Tạo dữ liệu mẫu khi DB trống
APP_SEED_ENABLED=true
# Hibernate Dialect (mặc định MariaDBDialect; đổi thành org.hibernate.dialect.MySQLDialect nếu dùng MySQL thuần)
# HIBERNATE_DIALECT=org.hibernate.dialect.MariaDBDialect
