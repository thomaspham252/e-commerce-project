# Copy thành .env nếu cần đổi. KHÔNG commit file .env
# Địa chỉ backend Spring Boot (Vite proxy /api → đây)
VITE_API_TARGET=http://localhost:8080

# TẠM THỜI khi chưa có đăng nhập: id tài khoản dùng cho trang Admin / NTD
# (dữ liệu mẫu: admin = 1, NTD TechAsia = 2, NTD FPT = 3)
VITE_DEV_ADMIN_ID=1
VITE_DEV_EMPLOYER_ID=2
